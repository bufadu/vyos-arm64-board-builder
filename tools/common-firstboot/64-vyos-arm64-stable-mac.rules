# NICs without a factory MAC get a random one at every boot (addr_assign_type 1),
# which breaks VyOS hw-id naming. Pin it before 65-vyos-net.rules runs, and mark
# the NIC so 64-vyos-arm64-stable-mac.link keeps systemd from replacing it.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="eth*|e*", ATTR{addr_assign_type}=="1", DRIVERS=="?*", PROGRAM="/usr/local/sbin/vyos-arm64-stable-mac.sh %k", ENV{VYOS_ARM64_STABLE_MAC}="1"
