From: bufadu <1352301+bufadu@users.noreply.github.com>
Subject: [PATCH] arm64: dts: rockchip: nanopi-r3s-lts: keep the SD card at 3.3 V

Drop sd-uhs-sdr50 so a warm reboot boots from the SD card again instead of
falling back to the factory eMMC system.
---
diff --git a/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s-lts.dts b/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s-lts.dts
--- a/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s-lts.dts
+++ b/arch/arm64/boot/dts/rockchip/rk3566-nanopi-r3s-lts.dts
@@ -51,6 +51,15 @@
 	status = "okay";
 };
 
+/*
+ * UHS-I switches the card to 1.8 V signalling. A warm reboot does not
+ * power-cycle it, so the eMMC SPL fails "voltage select" on the SD card and
+ * boots the factory eMMC system. Keep the card at 3.3 V (high speed).
+ */
+&sdmmc0 {
+	/delete-property/ sd-uhs-sdr50;
+};
+
 &vp0 {
 	vp0_out_hdmi: endpoint@ROCKCHIP_VOP2_EP_HDMI0 {
 		reg = <ROCKCHIP_VOP2_EP_HDMI0>;
